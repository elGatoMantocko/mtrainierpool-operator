{
  "name": "swimming",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "packageManager": "yarn@4.15.0",
  "dependencies": {
    "@b-fuze/deno-dom": "jsr:^0.1.56",
    "@cliffy/command": "jsr:^1.1.0",
    "@hey-api/openapi-ts": "^0.97.2",
    "@hono/zod-openapi": "jsr:^1.4.0",
    "@std/dotenv": "jsr:^0.225.6",
    "@std/uuid": "jsr:^1.1.1",
    "@supabase/functions-js": "jsr:^2.105.4",
    "@supabase/server": "^1.1.0",
    "@supabase/supabase-js": "jsr:^2.105.4",
    "hono": "^4.12.21",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@std/testing": "jsr:^1.0.18",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "pool": "deno run -A ./scripts/pool.ts",
    "typecheck": "deno check",
    "lint": "deno lint",
    "deno:refresh": "deno cache -r ./scripts/**/*.ts ./supabase/**/*.ts",
    "gen:types": "supabase gen types --schema public --local > ./supabase/functions/api/types/database.types.ts",
    "gen:schema": "supabase db dump --schema public --local > ./supabase/schema.sql",
    "gen:seed": "supabase db dump --schema public --data-only --local > ./supabase/seed.sql"
  }
}
