        "reopening_date": null,
        "confidence_score": 90,
        "reasoning": "All-day closure on Sunday June 28; no specific time given so start of day is assumed.",
        "flags": ["time_assumed"]
    },
    {
        "closure_date": null,
        "reopening_date": "2026-06-29T09:00:00-07:00",
        "confidence_score": 90,
        "reasoning": "Late opening Monday June 29 at 9am; this is a delayed reopening rather than a full-day closure.",
        "flags": []
    }
]

### Example (no closure)

